# Copy to .env.vercel for migration commands, or .env.local for Next.js testing.
# Add the same values to the Vercel project's server-side environment variables.
# Never use NEXT_PUBLIC_ prefixes for credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
# Stable owner identifier. Keep unchanged after creating companies.
ADMIN_USER_ID=admin
# Optional fallback. Prefer saving a separate Gemini key per company in Settings.
GEMINI_API_KEY=
